<table:table-row><table:table-cell office:value-type="string"><text:p>UI_RESTART_V2X_SESSION</text:p></table:table-cell><table:table-cell/><table:table-cell office:value-type="string"><text:p>restart the V2X session?</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>die V2X-Sitzung neu starten?</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>käynnistää V2X-istunnon uudelleen?</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>redémarrer la session V2X?</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>újraindítja a V2X-munkamenetet?</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>de V2X-sessie herstarten?</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>starta om V2X-sessionen?</text:p></table:table-cell><table:table-cell office:value-type="string"><text:p>перезапустити сеанс V2X?</text:p></table:table-cell></table:table-row>
